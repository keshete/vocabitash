rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.email == "keshet85@gmail.com";
    }
    function isCircleMember(circleId) {
      return circleId != null &&
        exists(/databases/$(database)/documents/circles/$(circleId)/members/$(request.auth.uid));
    }
    function isCircleModerator(circleId) {
      return circleId != null &&
        get(/databases/$(database)/documents/circles/$(circleId)).data.moderatorEmail == request.auth.token.email;
    }

    // Circles: independent groups, each with their own lists. Only the admin
    // can create/delete a circle or see the full list of circles; anyone
    // signed in can read a single circle by id (needed to join via an
    // invite link, and to show its name); the admin or that circle's own
    // moderator can update it (e.g. reassigning the moderator).
    match /circles/{circleId} {
      allow get: if request.auth != null;
      allow list: if isAdmin();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (request.auth != null && resource.data.moderatorEmail == request.auth.token.email);

      // Membership — proves who's in this circle. Joining now goes through a
      // request (below) that the moderator or admin approves, so a member
      // doc is created either by the admin/moderator (approving someone
      // else) or by someone adding themselves directly (e.g. the admin
      // bootstrapping their own membership); anyone can remove themselves,
      // and the admin or the circle's moderator can also remove someone.
      match /members/{memberUid} {
        // The resource.data.uid branch (alongside the memberUid path check)
        // is what lets the collectionGroup('members').where('uid','==',…)
        // query in loadMyCircles() validate: Firestore can only allow a
        // query when the rule's condition is provable from the query's own
        // equality filter, and a filter on the "uid" field only lines up
        // with a rule that also checks resource.data.uid.
        allow read: if isAdmin() || isCircleModerator(circleId) ||
          (request.auth != null && request.auth.uid == memberUid) ||
          (request.auth != null && resource.data.uid == request.auth.uid);
        allow create: if isAdmin() || isCircleModerator(circleId) ||
          (request.auth != null && request.auth.uid == memberUid);
        allow delete: if isAdmin() || isCircleModerator(circleId) ||
          (request.auth != null && request.auth.uid == memberUid);
      }

      // Join requests — created by whoever wants in (via an invite link),
      // only readable/removable by that circle's moderator or the admin
      // (approving = create the member doc above, then delete the request;
      // rejecting = just delete it), or by the requester themselves, so they
      // can withdraw their own pending request.
      match /requests/{requestUid} {
        allow create: if request.auth != null && request.auth.uid == requestUid;
        allow read, delete: if isAdmin() || isCircleModerator(circleId) ||
          (request.auth != null && request.auth.uid == requestUid);
      }
    }

    // Vocabulary lists and words: scoped to a circle (each has a circleId
    // field). Anyone who's a member of that circle can read; only that
    // circle's moderator, or the admin, can add/edit/delete — so no one
    // else can accidentally (or deliberately) change or delete a list.
    match /decks/{deckId} {
      allow read: if isAdmin() || isCircleMember(resource.data.circleId);
      allow create: if isAdmin() || isCircleModerator(request.resource.data.circleId);
      allow update, delete: if isAdmin() || isCircleModerator(resource.data.circleId);
    }
    match /words/{wordId} {
      allow read: if isAdmin() || isCircleMember(resource.data.circleId);
      allow create: if isAdmin() || isCircleModerator(request.resource.data.circleId);
      allow update, delete: if isAdmin() || isCircleModerator(resource.data.circleId);
    }

    // Each person's own practice progress, accepted answers, mnemonics, and
    // circle memberships — private: only that signed-in person can read or
    // write their own.
    match /data/users/{uid}/profile {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      match /{collection}/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Everything else: denied by default.
  }
}
