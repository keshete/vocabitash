rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Vocabulary lists and words: a shared pool everyone who's signed in can
    // read, but only the admin account can add/edit/delete — so no one else
    // can accidentally (or deliberately) change or delete someone's list.
    match /decks/{deckId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.email == "keshet85@gmail.com";
    }
    match /words/{wordId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.email == "keshet85@gmail.com";
    }

    // Each person's own practice progress, accepted answers and mnemonics —
    // private: only that signed-in person can read or write their own.
    match /data/users/{uid}/profile {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      match /{collection}/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Everything else: denied by default.
  }
}
